# Supabase session pooler — IPv4-compatible, use for app runtime traffic.
# Get this from Supabase → Project Settings → Database → Connection string → "Session pooler"
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

SECRET_KEY=
CALLBACK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://outpost-api.othaimeen.dev/auth/github/callback
FRONTEND_URL=https://outpost.othaimeen.dev
GITHUB_TOKEN=
GITHUB_REPO=othaime-en/outpost

REFRESH_COOKIE_DOMAIN=.othaimeen.dev
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=lax

AWS_REGION=us-east-1
AWS_ROLE_ARN=