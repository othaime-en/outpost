DATABASE_URL=postgresql://outpost:outpost@postgres:5432/outpost
SECRET_KEY=dev-secret-key-change-in-prod
CALLBACK_SECRET=dev-callback-secret

GITHUB_CLIENT_ID=your_client_id
GITHUB_CLIENT_SECRET=your_client_secret
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback
FRONTEND_URL=http://localhost:3000

# --- Auth token lifetimes ---
# All have working defaults (see app/config.py) — uncomment only to override.
# ACCESS_TOKEN_TTL_MINUTES=15
# REFRESH_TOKEN_TTL_DAYS=30

# --- Refresh cookie attributes ---
# Defaults work for local `docker compose` dev (UI:3000 + API:8000, both
# under localhost, which browsers treat as a secure context even over
# plain HTTP). Only touch these for a real deployment — see
# app/config.py's comments on each for when/why.
# REFRESH_COOKIE_NAME=outpost_refresh_token
# REFRESH_COOKIE_SECURE=true
# REFRESH_COOKIE_SAMESITE=lax
# REFRESH_COOKIE_DOMAIN=